DATABASE_URL=postgresql://user:password@localhost:5432/aidfinder
SECRET_KEY=votre_cle_secrete
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Dify (génération principale du chatbot) ────────────────────────
DIFY_API_KEY=
DIFY_API_URL=https://api.dify.ai/v1
DIFY_USER=

# ─── OpenRouter (utilisé par llm_client pour analyses/fallbacks) ────
# Modèle gratuit recommandé : qwen/qwen3-30b-a3b:free
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=qwen/qwen3-30b-a3b:free
OPENROUTER_MAX_TOKENS=700
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=AidFinder

# ─── Qwen / DashScope (fallback LLM) ────────────────────────────────
QWEN_API_KEY=
QWEN_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen-plus
QWEN_MAX_TOKENS=700
QWEN_TEMPERATURE=0.2
QWEN_TIMEOUT_SECONDS=30

# ─── Serveur (développement — accès réseau local) ───────────────────
HOST=0.0.0.0
PORT=8000

# Nombre de pages recentes ANAPEC emploi a synchroniser en mode normal.
# Mettre 0, all ou full pour un scan complet plus lent.
ANAPEC_EMPLOI_MAX_PAGES=20

# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Regex CORS pour les IP privées du réseau local (port frontend Vite)
# Laisser vide pour désactiver : CORS_ORIGIN_REGEX=
